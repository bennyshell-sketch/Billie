# ---------------------------------------------------------------------------
# Billie configuration.
#
#   cp .env.example .env      then paste your real keys into .env
#
# .env is git-ignored. Never put a real key in this file (.env.example IS
# committed) and never paste a key into a chat with an AI assistant.
# ---------------------------------------------------------------------------

# --- Cloud reasoning: Anthropic Claude API (phase 1) -----------------------
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
BILLIE_CLOUD_MODEL=claude-opus-5
BILLIE_CLOUD_MAX_TOKENS=16000
# low | medium | high | xhigh | max  (high is the API default)
BILLIE_CLOUD_EFFORT=high

# --- Local model: Ollama (phase 1) -----------------------------------------
# Install from https://ollama.com, then: ollama pull llama3.1:8b
BILLIE_OLLAMA_BASE_URL=http://127.0.0.1:11434
BILLIE_OLLAMA_MODEL=llama3.1:8b
# Optional: better retrieval than the built-in offline embedder.
#   ollama pull nomic-embed-text
BILLIE_OLLAMA_EMBED_MODEL=nomic-embed-text
BILLIE_USE_OLLAMA_EMBEDDINGS=false

# --- Routing ---------------------------------------------------------------
# auto | local | cloud  -- per-request flags always override this.
BILLIE_DEFAULT_ROUTE=auto
# 0.0-1.0. Requests scoring at or above this go to the cloud model.
BILLIE_COMPLEXITY_THRESHOLD=0.45

# --- Server ----------------------------------------------------------------
BILLIE_HOST=127.0.0.1
BILLIE_PORT=8765
# Bearer token for the API. Leave blank while you are only using localhost;
# it becomes REQUIRED before phase 6 (phone access over Tailscale).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BILLIE_API_TOKEN=
# Allow unauthenticated requests that arrive from this machine (127.0.0.1).
BILLIE_ALLOW_LOOPBACK_UNAUTHENTICATED=true

# --- Storage ---------------------------------------------------------------
BILLIE_DATA_DIR=data
BILLIE_NOTES_DIR=notes
BILLIE_LOG_LEVEL=INFO

# --- File indexing (phase 2) ------------------------------------------------
# Extra folders to index, comma-separated. The notes folder and the workspace
# are always included. Billie reads ONLY what is listed here -- there is no
# "index my whole drive" option, and a filesystem root or your bare home
# folder is refused with an explanation.
#   Windows:      BILLIE_INDEXED_FOLDERS=C:\Users\you\Documents\Research,C:\Projects\scripts
#   macOS/Linux:  BILLIE_INDEXED_FOLDERS=/home/you/Documents/Research,/home/you/projects
BILLIE_INDEXED_FOLDERS=

# The only folder Billie may write to, and only via a diff you approve.
BILLIE_WORKSPACE_DIR=workspace

# Files larger than this are skipped rather than indexed.
BILLIE_MAX_INDEXED_FILE_MB=8

# Seconds between checks for changed files. 0 turns the watcher off.
BILLIE_WATCH_INTERVAL_SECONDS=60

# How long an unapproved write proposal stays actionable.
BILLIE_PROPOSAL_TTL_MINUTES=120

# --- Google Calendar (phase 3) ----------------------------------------------
# In the Google Cloud console: create a project, enable the Google Calendar
# API, then create an OAuth client of type "Desktop app". Paste the two values
# it gives you here. Add http://127.0.0.1:8765/api/calendar/oauth/callback as
# an authorised redirect URI (use your BILLIE_PORT if you changed it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How far around today events are pulled into memory, so chat can cite them.
BILLIE_CALENDAR_DAYS_PAST=1
BILLIE_CALENDAR_DAYS_AHEAD=60
# Seconds between background calendar syncs. 0 turns it off.
BILLIE_CALENDAR_SYNC_INTERVAL_SECONDS=900

# Your Google refresh token goes in the OS keychain (Credential Locker on
# Windows, Keychain on macOS, Secret Service on Linux) -- never in this file.
# If no keychain exists, Billie refuses to store it rather than quietly writing
# it to disk. Set this to true only if you accept a permission-protected file
# in data/credentials.json instead.
BILLIE_ALLOW_FILE_TOKEN_STORE=false

# ---------------------------------------------------------------------------
# Later phases (documented now so you know what is coming; unused so far)
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=
# RUNWAY_API_KEY=
